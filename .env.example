# ═══════════════════════════════════════════════════════════════
# Inso Code — Frontend Environment Template
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit .env with real secrets to Git.
# ═══════════════════════════════════════════════════════════════

# ── Backend API ──
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# ── NextAuth ──
NEXTAUTH_URL=http://localhost:3005
NEXTAUTH_SECRET=generate-a-random-secret-here

# ── Sovereign Identity (Liberty Center One) ──
KEYCLOAK_CLIENT_ID=sovereign-workload-plane
KEYCLOAK_CLIENT_SECRET=super-secret
KEYCLOAK_ISSUER=https://api.inso.local/auth/realms/sovereign

# ── Stripe (use test keys for development) ──
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_KEY_HERE
