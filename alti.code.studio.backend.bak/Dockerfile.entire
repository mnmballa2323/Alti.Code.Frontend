FROM golang:alpine

# Install git (needed for go install if not static, and for the CLI potentially)
RUN apk add --no-cache git

# Install Entire CLI
RUN go install github.com/entireio/cli/cmd/entire@latest

# Add go bin to path (usually already there, but explicit is good)
ENV PATH="/go/bin:${PATH}"

# Keep container alive
ENTRYPOINT ["tail", "-f", "/dev/null"]
