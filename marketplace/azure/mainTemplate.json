{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "customerName": {
      "type": "string",
      "metadata": {
        "description": "Your Enterprise Organization Name."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources."
      }
    },
    "enableSgxConfidentialComputing": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Force deployment on Intel SGX hardware encrypted memory VMs."
      }
    }
  },
  "variables": {
    "aksClusterName": "[concat('alti-data-plane-', parameters('customerName'))]",
    "vnetName": "[concat('alti-vnet-', parameters('customerName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2021-02-01",
      "name": "[variables('vnetName')]",
      "location": "[parameters('location')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": ["10.0.0.0/16"]
        },
        "subnets": [
          {
            "name": "aksSubnet",
            "properties": {
              "addressPrefix": "10.0.1.0/24"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.ContainerService/managedClusters",
      "apiVersion": "2023-01-01",
      "name": "[variables('aksClusterName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
      ],
      "properties": {
        "dnsPrefix": "[variables('aksClusterName')]",
        "agentPoolProfiles": [
          {
            "name": "confpool",
            "count": 3,
            "vmSize": "[if(parameters('enableSgxConfidentialComputing'), 'Standard_DC4s_v3', 'Standard_D4s_v4')]",
            "osType": "Linux",
            "mode": "System"
          }
        ],
        "confidentialComputing": {
          "sgxQuoteHelperEnabled": "[parameters('enableSgxConfidentialComputing')]"
        },
        "networkProfile": {
          "networkPlugin": "azure",
          "loadBalancerSku": "standard"
        }
      },
      "identity": {
        "type": "SystemAssigned"
      }
    }
  ],
  "outputs": {
    "clusterName": {
      "type": "string",
      "value": "[variables('aksClusterName')]"
    }
  }
}
