{
  "$schema": "https://schema.management.azure.com/schemas/0.1.2-preview/CreateUIDefinition.MultiVm.json#",
  "handler": "Microsoft.Azure.CreateUIDef",
  "version": "0.1.2-preview",
  "parameters": {
    "basics": [
      {
        "name": "customerName",
        "type": "Microsoft.Common.TextBox",
        "label": "Enterprise Organization Name",
        "toolTip": "Enter your organization name.",
        "constraints": {
          "required": true,
          "regex": "^[a-z0-9-]{3,24}$",
          "validationMessage": "Only lowercase letters, numbers, and hyphens. 3-24 characters."
        }
      }
    ],
    "steps": [
      {
        "name": "securitySettings",
        "label": "Military-Grade Security Configuration",
        "subLabel": {
          "preValidation": "Configure SGX and MHSM",
          "postValidation": "Done"
        },
        "elements": [
          {
            "name": "enableSgxConfidentialComputing",
            "type": "Microsoft.Common.CheckBox",
            "label": "Enable Intel SGX Hardware Memory Encryption",
            "toolTip": "Forces the data plane to execute entirely within encrypted RAM. Microsoft engineers cannot read this memory.",
            "defaultValue": true
          },
          {
            "name": "altiControlPlaneMTLSKey",
            "type": "Microsoft.Common.PasswordBox",
            "label": "Alti Control Plane mTLS Key",
            "toolTip": "The mTLS tether key provided by your Alti Account Manager.",
            "constraints": {
              "required": true
            }
          }
        ]
      }
    ],
    "outputs": {
      "customerName": "[steps('basics').customerName]",
      "location": "[location()]",
      "enableSgxConfidentialComputing": "[steps('securitySettings').enableSgxConfidentialComputing]"
    }
  }
}
