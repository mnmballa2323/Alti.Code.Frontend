{
  "watch": ["src", "server.js", "index.js"],
  "ext": "js,json,cjs,mjs",
  "ignore": [
    "*.log",
    "*.jsonl",
    "*.txt",
    "logs/**",
    "uploads/**",
    "tests/**",
    "node_modules/**",
    ".shadow/**",
    ".git/**",
    "*.bak",
    "*.refactored.bak",
    "src/app/modules/agents/custom/**",
    "generated/**",
    "data/**",
    "Alti.Code.Studio.backup/**"
  ],
  "delay": "1000"
}
