FROM node:20.18.1-alpine

# Set non-root user for true zero-trust execution
RUN addgroup -S agentgroup && adduser -S agentuser -G agentgroup

WORKDIR /sandbox

# Environment variables injected by orchestrator
ENV AGENT_ID="unknown"
ENV TASK="idle"

# Copy the lightweight runner script
COPY agent-runner.js /sandbox/agent-runner.js

RUN chown -R agentuser:agentgroup /sandbox
USER agentuser

# Entrypoint
CMD ["node", "agent-runner.js"]
