# ── INSO CODE BACKEND CONFIGURATION ──
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3001

# ── Database Connections ──
DATABASE_URL="postgresql://username:password@127.0.0.1:5432/mydb?schema=public"
# DISABLE_REDIS=true
REDIS_URL=redis://127.0.0.1:6379

# ── JWT Authentication Secrets ──
JWT_ACCESS_TOKEN=your-random-32-char-access-secret-key
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_REFRESH_TOKEN=your-random-32-char-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=30d

# ── AgentMemory Service ──
AGENTMEMORY_PORT=3111
AGENTMEMORY_TOOLS=all
GRAPH_EXTRACTION_ENABLED=true
CONSOLIDATION_ENABLED=true

# ── OpenStack Liberty Center One Configurations ──
PRIVATE_CLOUD_MODE=true
OS_AUTH_URL=https://identity.libertycenterone.com:5000/v3
OPENSTACK_DEFAULT_DOMAIN=Default

# ── Tri-Cloud AI Model Gateways ──
# AWS Bedrock (Claude)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

# GCP Vertex AI (Gemini)
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=path/to/gcp-credentials.json

# Azure OpenAI Foundry (GPT)
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-azure-openai-endpoint.openai.azure.com
