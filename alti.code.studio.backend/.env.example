# ── INSO CODE BACKEND CONFIGURATION ──
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3001

# ── Database Connections ──
DATABASE_URL="postgresql://username:password@127.0.0.1:5432/mydb?schema=public"
# DISABLE_REDIS=true
REDIS_URL=redis://127.0.0.1:6379

# ── JWT Authentication Secrets ──
JWT_ACCESS_TOKEN=your-random-32-char-access-secret-key
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_REFRESH_TOKEN=your-random-32-char-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=30d

# ── AgentMemory Service ──
AGENTMEMORY_PORT=3111
AGENTMEMORY_TOOLS=all
GRAPH_EXTRACTION_ENABLED=true
CONSOLIDATION_ENABLED=true

# ── OpenStack Liberty Center One Configurations ──
PRIVATE_CLOUD_MODE=true
OS_AUTH_URL=https://identity.libertycenterone.com:5000/v3
OPENSTACK_DEFAULT_DOMAIN=Default

# ── Tri-Cloud AI Model Gateways ──
# AWS Bedrock (Claude)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

# GCP Vertex AI (Gemini)
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=path/to/gcp-credentials.json

# Azure OpenAI Foundry (GPT)
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-azure-openai-endpoint.openai.azure.com

# ── Official MCP Integrations (Opt-in) ──
# To activate any of the native MCP servers, set the flag to true.
# Warning: Enabling hundreds of MCPs simultaneously will consume significant system resources.

MCP_ENABLE_FILESYSTEM=false
MCP_ENABLE_MCP_TOOLBOX=false
MCP_ENABLE_SQLITE=false
MCP_ENABLE_POSTGRES=false
MCP_ENABLE_MYSQL=false
MCP_ENABLE_REDIS=false
MCP_ENABLE_MONGODB=false
MCP_ENABLE_ELASTICSEARCH=false
MCP_ENABLE_NEON=false
MCP_ENABLE_SUPABASE=false

MCP_ENABLE_GIT=false
MCP_ENABLE_GITHUB=false
MCP_ENABLE_GITLAB=false
MCP_ENABLE_JIRA=false
MCP_ENABLE_LINEAR=false
MCP_ENABLE_NOTION=false
MCP_ENABLE_CONFLUENCE=false

MCP_ENABLE_AWS=false
MCP_ENABLE_GCP=false
MCP_ENABLE_AZURE=false
MCP_ENABLE_KUBERNETES=false
MCP_ENABLE_DOCKER=false
MCP_ENABLE_TERRAFORM=false
MCP_ENABLE_CLOUDFLARE=false

MCP_ENABLE_SENTRY=false
MCP_ENABLE_DATADOG=false
MCP_ENABLE_PROMETHEUS=false

MCP_ENABLE_SEQUENTIAL_THINKING=false
MCP_ENABLE_MEMORY=false
MCP_ENABLE_FETCH=false
MCP_ENABLE_PUPPETEER=false
MCP_ENABLE_PDF=false
MCP_ENABLE_NPM=false
MCP_ENABLE_PYTHON=false
MCP_ENABLE_BRAVE_SEARCH=false
MCP_ENABLE_GOOGLE_MAPS=false

MCP_ENABLE_SLACK=false
MCP_ENABLE_DISCORD=false
MCP_ENABLE_STRIPE=false
MCP_ENABLE_FIGMA=false
