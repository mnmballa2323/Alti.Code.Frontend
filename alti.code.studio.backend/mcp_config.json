{
  "mcpServers": {
    "local-sqlite": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sqlite", "--db", "alti_swarm.db"],
      "env": {}
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": ""
      }
    },
    "graphify": {
      "command": "/Users/michaelmeram/workspace/alti.code.studio/alti.code.studio.backend/submodules/graphify/.venv/bin/python",
      "args": ["-m", "graphify", "mcp"],
      "env": {}
    },
    "fazm": {
      "command": "node",
      "args": ["/Users/michaelmeram/workspace/alti.code.studio/submodules/fazm/acp-bridge/dist/fazm-tools-stdio.js"],
      "env": {}
    },
    "custom-diagnostics": {
      "command": "node",
      "args": ["/Users/michaelmeram/workspace/alti.code.studio/alti.code.studio.backend/src/app/modules/mcp/custom_mcp.js"],
      "env": {}
    },
    "puppeteer": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-puppeteer"],
      "env": {}
    },
    "codebase-memory": {
      "command": "npx",
      "args": ["-y", "codebase-memory-mcp", "--ui=true", "--port=9749"],
      "env": {}
    },
    "loop-engineering": {
      "command": "node",
      "args": ["/Users/michaelmeram/workspace/alti.code.studio/submodules/loop-engineering/tools/mcp-server/dist/index.js"],
      "env": {}
    }
  }
}
