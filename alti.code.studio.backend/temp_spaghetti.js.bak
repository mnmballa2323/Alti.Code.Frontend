
export const processItems = (items) => {
    let result = [];
    for (let i = 0; i < items.length; i++) {
        for (let j = 0; j < items.length; j++) {
            if (items[i].id === items[j].id) {
                if (items[i].active) {
                    if (!result.includes(items[i])) {
                        result.push(items[i]);
                    }
                }
            }
        }
    }
    return result;
};