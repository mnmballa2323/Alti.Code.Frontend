# ==============================================================================
# ALTI CODE STUDIO: PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env on the production server and fill in actual credentials.
# Do NOT commit the actual populated secrets to the git repository.
# ==============================================================================

PORT=5000
NODE_ENV=production
DISABLE_REDIS=false
REDIS_URL=redis://synapse:6379

# ── Primary Database (PostgreSQL with pgvector) ──
# Replace with actual PostgreSQL connection URL.
# Example: postgresql://username:password@postgres-host:5432/dbname?schema=public
DATABASE_URL="postgresql://postgres:password@postgres-host:5432/alti_production?schema=public"

# ── JWT Authentication Secrets ──
# Generate strong 256-bit keys for production.
JWT_ACCESS_TOKEN=""
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_REFRESH_TOKEN=""
JWT_REFRESH_EXPIRES_IN=30d

# ── Private Cloud Mode Configuration (OpenStack / Liberty Center One) ──
PRIVATE_CLOUD_MODE=true

# ── OpenStack Keystone API Credentials (VPC Scaffolding / COE) ──
OS_AUTH_URL=https://identity.libertycenterone.com:5000/v3
OS_USERNAME=""
OS_PASSWORD=""
OS_PROJECT_NAME=""
OS_USER_DOMAIN_NAME=Default
OS_PROJECT_DOMAIN_NAME=Default

# ── Tri-Cloud AI Inference Credentials (Direct Access Mode) ──

# 1. AWS Bedrock (Claude 3.5 Sonnet / The Architect)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=us-east-1

# 2. GCP Vertex AI (Gemini 3.1 Pro / The QA healer)
# Place the service account JSON key file on the server and point to its path.
GOOGLE_APPLICATION_CREDENTIALS="/app/secrets/gcp-service-account.json"

# 3. Azure OpenAI Foundry (GPT-5.5 / The DevSecOps Sentinel)
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT="https://your-resource-name.openai.azure.com/"

# ── Third-Party APIs (Optional) ──
COMPOSIO_API_KEY=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""
