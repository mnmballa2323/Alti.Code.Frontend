# ==============================================================================
# ALTI CODE STUDIO: FRONTEND PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env on the production frontend server and populate actuals.
# Do NOT commit populated secrets to the repository.
# ==============================================================================

# ── API Gateway Configuration ──
# Set to the public API endpoint for the deployed backend service.
# Example: https://api.customer-domain.com/api/v1
NEXT_PUBLIC_API_URL="https://api.your-domain.com/api/v1"

# ── NextAuth Configuration ──
# Set to the public canonical URL of your frontend application.
# Example: https://app.customer-domain.com
NEXTAUTH_URL="https://app.your-domain.com"

# Set a strong cryptographic key for session encryption.
NEXTAUTH_SECRET=""

# ── Google OAuth Integration ──
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# ── Stripe Payment Integration (Production) ──
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
