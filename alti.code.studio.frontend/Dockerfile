# ==============================================================================
# ALTI CODE STUDIO: SOVEREIGN FRONTEND DOCKERFILE
# ==============================================================================
# This Dockerfile utilizes a multi-stage Next.js standalone build pattern to 
# strictly enforce zero-trust sovereign deployment principles.
# It minimizes the attack surface by discarding development dependencies and 
# running exclusively as a non-privileged `nextjs` user.
# ==============================================================================

# -------------------------
# STAGE 1: Dependency Layer
# -------------------------
FROM node:20-alpine AS deps
# Install libc6-compat for Alpine compatibility with some Node.js native modules
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Copy dependency manifests
COPY package.json package-lock.json ./
# Install ALL dependencies (including dev) to build the app
RUN npm ci --legacy-peer-deps

# -------------------------
# STAGE 2: Build Builder Layer
# -------------------------
FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Ensure standalone mode is injected via environment variable if not in next.config.js
ENV NEXT_TELEMETRY_DISABLED 1

# Generate the highly optimized Next.js standalone build
RUN npm run build

# -------------------------
# STAGE 3: Production Sovereign Layer
# -------------------------
FROM node:20-alpine AS runner
WORKDIR /app

# 🛡️ Sovereign Security Matrix: Hardened Runtime Context
ENV NODE_ENV production
ENV NEXT_TELEMETRY_DISABLED 1
ENV PORT 3000
ENV HOSTNAME "0.0.0.0"

# Enforce strict non-root user execution privileges
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Set correct permissions for the cache directory
RUN mkdir .next
RUN chown nextjs:nodejs .next

# Copy the stripped-down standalone files generated by the builder
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

# Drop to the non-root execution context
USER nextjs

EXPOSE 3000

# Execute the standalone Node.js server directly, bypassing the heavy npm wrapper
CMD ["node", "server.js"]
